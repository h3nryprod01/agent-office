#!/bin/bash
# lane L1: refuse to push commits that leak a home path, private IP, token, or a
# term from your local denylist (~/.agent-office/leak-denylist.txt).
#
# NOT installed automatically. To enable it in this clone (all worktrees share it):
#   cp scripts/hooks/pre-push "$(git rev-parse --git-path hooks)/pre-push"
#   chmod +x "$(git rev-parse --git-path hooks)/pre-push"
# To skip once, knowingly: git push --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
ZERO="0000000000000000000000000000000000000000"
status=0

while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue # deleting a branch
  if [ "$remote_sha" != "$ZERO" ]; then
    range="$remote_sha..$local_sha"
  elif git rev-parse --verify -q origin/main >/dev/null; then
    range="origin/main..$local_sha" # new branch: what it adds over main
  else
    node "$ROOT/scripts/check-leaks.mjs" || status=1 # nothing to diff against: scan the tree
    continue
  fi
  node "$ROOT/scripts/check-leaks.mjs" --range "$range" || status=1
done

[ "$status" -eq 0 ] || echo "push blocked by the leak gate (see above)." >&2
exit "$status"
